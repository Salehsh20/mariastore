{
  "version": 2,
  "functions": {
    "backend/server.js": {
      "runtime": "vercel-nodejs@3.1.0"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/server.js" },
    { "src": "/admin/js/(.*)", "dest": "/admin/js/$1" },
    { "src": "/admin/(.*)", "dest": "/admin/$1" },
    { "src": "/admin", "dest": "/admin/index.html" },
    { "src": "/js/(.*)", "dest": "/frontend/js/$1" },
    { "src": "/(product|cart)\\.html", "dest": "/frontend/$0" },
    { "src": "/", "dest": "/frontend/index.html" }
  ]
}
